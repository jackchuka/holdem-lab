{
  "name": "holdem-lab",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackchuka/holdem-lab.git"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint --type-aware",
    "e2e": "pnpm -r --if-present e2e",
    "check-licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
